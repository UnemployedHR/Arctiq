{
  "random_seed": 42,
  "architecture": "GRU",
  "input_size": 32,
  "hidden_size": 128,
  "num_layers": 2,
  "dropout": 0.2,
  "output_size": 2,
  "batch_size": 128,
  "learning_rate": 0.001,
  "max_epochs": 200,
  "early_stop_patience": 20,
  "feature_cols": [
    "lat",
    "lon",
    "prev_delta_lat",
    "prev_delta_lon",
    "prev_displacement_km",
    "prev_speed_mps",
    "prev_bearing_sin",
    "prev_bearing_cos",
    "prev_dt_hours",
    "forecast_dt_hours",
    "doy_sin",
    "doy_cos",
    "hr_sin",
    "hr_cos",
    "SIZE_BLK",
    "SIZE_DD",
    "SIZE_DOM",
    "SIZE_GEN",
    "SIZE_ISL",
    "SIZE_NTB",
    "SIZE_PIN",
    "SIZE_RAD",
    "SIZE_TAB",
    "SIZE_WDG",
    "SHAPE_BB",
    "SHAPE_GEN",
    "SHAPE_GR",
    "SHAPE_LG",
    "SHAPE_MED",
    "SHAPE_RAD",
    "SHAPE_SM",
    "SHAPE_VLG"
  ],
  "target_cols": [
    "target_delta_lat",
    "target_delta_lon"
  ],
  "pytorch_available": true
}