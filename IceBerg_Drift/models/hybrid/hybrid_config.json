{
  "random_seed": 42,
  "architecture": "PhysicsPrior + GBR residual correction",
  "physics_prior": "scaled-persistence (prev_delta * forecast_dt/prev_dt)",
  "residual_model": "GradientBoostingRegressor (n_estimators=200)",
  "feature_cols": [
    "lat",
    "lon",
    "prev_delta_lat",
    "prev_delta_lon",
    "prev_displacement_km",
    "prev_speed_mps",
    "prev_bearing_sin",
    "prev_bearing_cos",
    "prev_dt_hours",
    "forecast_dt_hours",
    "doy_sin",
    "doy_cos",
    "hr_sin",
    "hr_cos",
    "SIZE_BLK",
    "SIZE_DD",
    "SIZE_DOM",
    "SIZE_GEN",
    "SIZE_ISL",
    "SIZE_NTB",
    "SIZE_PIN",
    "SIZE_RAD",
    "SIZE_TAB",
    "SIZE_WDG",
    "SHAPE_BB",
    "SHAPE_GEN",
    "SHAPE_GR",
    "SHAPE_LG",
    "SHAPE_MED",
    "SHAPE_RAD",
    "SHAPE_SM",
    "SHAPE_VLG",
    "phys_dlat",
    "phys_dlon"
  ],
  "target_cols": [
    "target_delta_lat",
    "target_delta_lon"
  ],
  "note_openberg": "Full OpenBerg physics baseline requires individual GLORYS+ERA5 downloads for each iceberg. These are not available for the full dataset. Iceberg 20857 OpenBerg June 9 error: 30.01 km (Case A surface-only) is documented in FORCING_ATTRIBUTION_7DAY.md as a REFERENCE ONLY point."
}