# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must NEVER be committed.

# ── AISStream (server-side only — never expose to the browser) ────────────────
# Obtain a free API key at: https://aisstream.io
# Leave blank to run in Simulator Mode (25 mock vessels across 5 shipping corridors)
AISSTREAM_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 3001)
PORT=3001
